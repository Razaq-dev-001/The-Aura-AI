# ==============================================================================
# AURA — Environment Configuration
# Free-first personal AI engine. All settings have sensible local defaults.
# ==============================================================================

# Server Configuration
PORT=3001
HOST=localhost
NODE_ENV=development
DATA_DIR=./data
DEFAULT_PROJECTS_DIR=./projects

# AI Provider Configuration (Default: Ollama)
DEFAULT_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_DEFAULT_MODEL=qwen2.5-coder:latest

# Optional Cloud Providers (Leave blank for ₹0/month local setup)
# Gemini API Key (Generous free tier available at https://aistudio.google.com)
GEMINI_API_KEY=
GEMINI_DEFAULT_MODEL=gemini-2.0-flash

# OpenAI API Key (Optional)
OPENAI_API_KEY=
OPENAI_DEFAULT_MODEL=gpt-4o

# Anthropic API Key (Optional)
ANTHROPIC_API_KEY=
ANTHROPIC_DEFAULT_MODEL=claude-3-5-sonnet-20241022

# Security & Safety
AGENT_DEFAULT_MODE=ASSIST
MAX_AGENT_ITERATIONS=15
COMMAND_TIMEOUT_MS=60000
AUTO_APPROVE_SAFE_COMMANDS=true
ENABLE_WEB_SEARCH=true

# Client URL (for CORS)
CORS_ORIGIN=http://localhost:5173
